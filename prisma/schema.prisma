generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProfessionalRegistration {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  cedula        String
  profession    String
  specialty     String?
  institution   String?
  address       String?
  city          String   @default("Santo Domingo")
  province      String   @default("Distrito Nacional")
  motivation    String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String?
  content       String
  coverImage    String?
  author        String   @default("SAPG Fuerza del Pueblo")
  published     Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GalleryImage {
  id            String   @id @default(cuid())
  title         String
  description   String?
  imageUrl      String
  category      String   @default("eventos")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String
  date          DateTime
  location      String
  imageUrl      String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Testimonial {
  id            String   @id @default(cuid())
  name          String
  profession    String
  content       String
  imageUrl      String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
}
